# Plantilla para desarrollo local: copiar a .env (no se versiona). No usar estos valores en producción.

# Contenedor PostgreSQL/PostGIS: usar los mismos valores en `docker run -e ...` (ver README).
POSTGRES_USER=ecoalert
POSTGRES_PASSWORD=ecoalert_dev
POSTGRES_DB=ecoalert

# Cadena de conexión que lee app/main.py (psycopg).
DATABASE_URL=postgresql://ecoalert:ecoalert_dev@localhost:5432/ecoalert

# Secreto de la huella HMAC de Idempotency-Key (obligatorio, sin valor por defecto). Generar uno propio con:
#   [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
IDEMPOTENCY_SECRET=reemplazar-por-un-valor-aleatorio
