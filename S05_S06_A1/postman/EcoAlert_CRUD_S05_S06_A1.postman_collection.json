{
  "info": {
    "name": "EcoAlert — Servicios CRUD (S05-S06-A1)",
    "description": "Ejecuta primero la carpeta 0 (fuera de cámara) y luego graba la carpeta 1 en orden. Guía: S05_S06_A1/paso_a_paso_video.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "coord_correo",
      "value": "coordinacion@ecoalert.pe"
    },
    {
      "key": "coord_password",
      "value": "Coordinacion-Demo-2026"
    },
    {
      "key": "password_temporal",
      "value": "Temporal-2026-xyz"
    },
    {
      "key": "password_nueva",
      "value": "Analista-Nueva-2026"
    },
    {
      "key": "analista_correo",
      "value": ""
    },
    {
      "key": "usuario_id",
      "value": ""
    },
    {
      "key": "token_coord",
      "value": ""
    },
    {
      "key": "token_analista",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Preparación (antes de grabar)",
      "item": [
        {
          "name": "Login de Coordinación",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token_coord\", pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{coord_correo}}\",\n  \"password\": \"{{coord_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "1. Video (grabar en este orden)",
      "item": [
        {
          "name": "1 · POST /usuarios (crear cuenta)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"analista_correo\", `analista.${Date.now()}@ecoalert.pe`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"usuario_id\", pm.response.json().id);",
                  "pm.test(\"Incluye Location\", () => pm.response.to.have.header(\"Location\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_coord}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre_completo\": \"Ana Quispe Mamani\",\n  \"correo\": \"{{analista_correo}}\",\n  \"rol\": \"analista_sig\",\n  \"password_temporal\": \"{{password_temporal}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2 · GET /usuarios/{id} (el POST persistió)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Es la cuenta creada\", () => pm.expect(pm.response.json().correo).to.eql(pm.collectionVariables.get(\"analista_correo\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_coord}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios/{{usuario_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "{{usuario_id}}"
              ]
            }
          }
        },
        {
          "name": "3 · PATCH /usuarios/{id} (editar nombre)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/merge-patch+json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_coord}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios/{{usuario_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "{{usuario_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre_completo\": \"Ana Quispe Mamani (editada)\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "4 · GET /usuarios?activo=true (la edición persistió)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Aparece con el nombre editado\", () => {",
                  "  const u = pm.response.json().find(x => x.id === pm.collectionVariables.get(\"usuario_id\"));",
                  "  pm.expect(u.nombre_completo).to.eql(\"Ana Quispe Mamani (editada)\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_coord}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios?activo=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ],
              "query": [
                {
                  "key": "activo",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "5 · POST /auth/login (la cuenta nueva inicia sesión)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token_analista\", pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{analista_correo}}\",\n  \"password\": \"{{password_temporal}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "6 · PUT /auth/password (cambiar contraseña temporal)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_analista}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password_actual\": \"{{password_temporal}}\",\n  \"password_nueva\": \"{{password_nueva}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "7 · DELETE /usuarios/{id} (no se borran cuentas: 405)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 405\", () => pm.response.to.have.status(405));",
                  "pm.test(\"Código METODO_NO_PERMITIDO\", () => pm.expect(pm.response.json().codigo).to.eql(\"METODO_NO_PERMITIDO\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_coord}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios/{{usuario_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "{{usuario_id}}"
              ]
            }
          }
        }
      ]
    }
  ]
}