          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "pm.sendRequest({ url: pm.variables.replaceIn('{{baseUrl}}/usuarios?activo=true'), method: 'GET' }, (err, res) => {",
              "  pm.collectionVariables.set('coordinadoresActivos', String(err ? -1 : res.json().filter(u => u.rol === 'coordinacion').length));",
              "});"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "const n = Number(pm.collectionVariables.get('coordinadoresActivos'));",
              "if (n === 1) {",
              "  pm.test('409 ULTIMA_COORDINACION: es la única coordinación activa (RF-02-AC-8)', () => {",
              "    pm.response.to.have.status(409);",
              "    pm.expect(pm.response.json().codigo).to.eql('ULTIMA_COORDINACION');",
              "    pm.expect(pm.response.json().mensaje).to.eql('No se puede desactivar la última cuenta de coordinación');",
              "  });",
              "} else {",
              "  pm.test('200: hay ' + n + ' coordinaciones activas, la baja es válida', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().activo).to.eql(false); });",
              "}"
            ] } }
