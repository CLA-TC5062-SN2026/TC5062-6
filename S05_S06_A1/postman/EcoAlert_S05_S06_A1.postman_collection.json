          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/merge-patch+json" }],
            "body": { "mode": "raw", "raw": "{\n  \"activo\": false\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/usuarios/{{coordId}}", "host": ["{{baseUrl}}"], "path": ["usuarios", "{{coordId}}"] },
            "description": "El resultado depende del estado de la base: con una sola coordinación activa responde 409; si hay otras, 200. El test se adapta al conteo real."
          }
        },
        {
          "name": "2.15c PUT desactivar la coordinación (409 ULTIMA_COORDINACION si es la única activa)",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "pm.sendRequest({ url: pm.variables.replaceIn('{{baseUrl}}/usuarios?activo=true'), method: 'GET' }, (err, res) => {",
              "  const activas = err ? [] : res.json().filter(u => u.rol === 'coordinacion');",
              "  pm.collectionVariables.set('coordUnica', String(activas.length === 1 && activas[0].id === pm.collectionVariables.get('coordId')));",
              "});"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "if (pm.collectionVariables.get('coordUnica') === 'true') {",
              "  pm.test('409 ULTIMA_COORDINACION: PUT no puede desactivar a la única coordinación activa (RF-02-AC-8)', () => {",
              "    pm.response.to.have.status(409);",
              "    pm.expect(pm.response.json().codigo).to.eql('ULTIMA_COORDINACION');",
              "  });",
              "} else {",
              "  pm.test('200: la cuenta no es la única coordinación activa, el reemplazo es válido', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().activo).to.eql(false); });",
              "}"
            ] } }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre_completo\": \"Coordinación de Prueba\",\n  \"rol\": \"coordinacion\",\n  \"activo\": false\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/usuarios/{{coordId}}", "host": ["{{baseUrl}}"], "path": ["usuarios", "{{coordId}}"] },
            "description": "Misma regla que PATCH: el reemplazo reutiliza las validaciones y la transacción. El test calcula si la cuenta es la única coordinación activa y espera 409 o 200 según corresponda."
          }
        }
      ]
    }
  ]
}
