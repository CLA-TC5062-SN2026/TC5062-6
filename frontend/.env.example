# Copiar a .env (no se versiona). Las variables VITE_* quedan visibles en el navegador: no poner secretos.

# URL base de la API REST (incluye el prefijo /api/v1 del contrato).
# Por defecto es relativa: el navegador llama al mismo origen del frontend y el proxy de Vite la reenvía
# al backend (desarrollo) o Nginx la reenvía (producción). Así no hace falta habilitar CORS en el backend.
VITE_API_URL=/api/v1

# Tiempo máximo de espera de cada petición, en milisegundos.
VITE_API_TIMEOUT_MS=15000

# Solo para el servidor de desarrollo de Vite (no llega al navegador): adónde reenviar /api.
# Local: http://localhost:8000. En Codespaces el backend corre en el mismo contenedor, así que también
# sirve http://localhost:8000 aunque el frontend se abra con la URL pública del puerto 5173.
API_PROXY_TARGET=http://localhost:8000
